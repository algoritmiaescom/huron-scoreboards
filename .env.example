# Copy to .env (or .env.local for app-only settings). Never commit either file.

# Application, development only: mock uses data/mock/; archive uses data/ without mock records.
# Restart the development server after changing this value.
# Production always uses archive, regardless of this setting.
VITE_DATA_SOURCE=mock

# Scripts under scripts/ load .env automatically. Vite exposes only VITE_ variables to the browser.
# Use a permanent Juicer dashboard API key, not a temporary /v1/authorize key.
JUICER_API_KEY=
