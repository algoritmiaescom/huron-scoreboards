{
  "name": "huron-scoreboards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint:python": "uv run --locked --project scripts/standings-ingestion ruff check scripts/standings-ingestion scripts/standings-spike",
    "format:python": "uv run --locked --project scripts/standings-ingestion ruff format scripts/standings-ingestion scripts/standings-spike",
    "format:python:check": "npm run format:python -- --check",
    "typecheck:python": "uv run --locked --project scripts/standings-ingestion mypy --config-file pyproject.toml scripts/standings-ingestion && uv run --locked --project scripts/standings-spike mypy --config-file pyproject.toml scripts/standings-spike",
    "validate:python": "npm run lint:python && npm run format:python:check && npm run typecheck:python",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:python:coverage": "uv run --locked --project scripts/standings-ingestion pytest scripts/standings-ingestion --cov=iteso_document_extract --cov-config=pyproject.toml --cov-report=term-missing --cov-report=xml:coverage-python/documents.xml && uv run --locked --project scripts/standings-spike pytest scripts/standings-spike --cov=spike --cov-config=pyproject.toml --cov-report=term-missing --cov-report=xml:coverage-python/spike.xml",
    "test:e2e": "playwright test",
    "validate:data": "tsx --tsconfig tsconfig.scripts.json scripts/validate-data.ts",
    "ingest:media": "tsx --tsconfig tsconfig.scripts.json scripts/ingest-media.ts",
    "media:pull-request": "tsx --tsconfig tsconfig.scripts.json scripts/media-pull-request.ts",
    "standings:ingest": "tsx --tsconfig tsconfig.scripts.json scripts/standings-ingestion/run.ts",
    "standings:pull-request": "tsx --tsconfig tsconfig.scripts.json scripts/standings-ingestion/pull-request.ts",
    "test:standings-documents": "uv run --locked --project scripts/standings-ingestion pytest scripts/standings-ingestion",
    "standings:spike": "uv run --locked --project scripts/standings-spike python scripts/standings-spike/spike.py",
    "validate": "npm run format:check && npm run lint && npm run validate:data && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "parse5": "8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.0.4",
    "axios": "^1.20.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.4"
  }
}
